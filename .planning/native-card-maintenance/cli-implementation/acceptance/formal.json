      "statusCode": 200,
      "response": {
        "data": {
          "path": "frontend/main.js",
          "mediaType": "text/javascript",
          "encoding": "utf8",
          "content": "export function mount({ api }) {\n const panel=api.ui.register(\"panel\",{elements:{location:{selector:\"#location\",kind:\"text\"},latest:{selector:\"#latest\",kind:\"control\"},chat:{selector:\"#chat\",kind:\"container\"}}});\n panel.bind(\"view\",record=>({location:{text:String(record.variables.location)}}));\n panel.on(\"latest\",\"click\",()=>api.history.latest());\n api.widgets.mountChat(panel,\"chat\");\n}\n"
        }
