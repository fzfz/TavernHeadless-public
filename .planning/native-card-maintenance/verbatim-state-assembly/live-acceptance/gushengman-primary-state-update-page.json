acter-scale) * 1.08));\n}\n\n.gal-character.near.gal-character-right {\n  transform: translateX(-50%) scaleX(-1) scale(calc(var(--character-scale) * 1.08));\n}\n\n.gal-character.away.gal-character-left,\n.gal-character.away.gal-character-center {\n  transform: translateX(-50%) scale(calc(var(--character-scale) * .92));\n}\n\n.gal-character.away.gal-character-right {\n  transform: translateX(-50%) scaleX(-1) scale(calc(var(--character-scale) * .92));\n}\n\n.gal-character.motion-shake {\n  animation: gal-shake .5s ease-in-out;\n}\n\n.gal-character.motion-up {\n  animation: gal-jump-up .32s ease-out;\n}\n\n.gal-character.motion-down {\n  animation: gal-jump-down .32s ease-out;\n}\n\n@keyframes gal-shake {\n  0%, 100% { margin-left: 0; }\n  25% { margin-left: -8px; }\n  75% { margin-left: 8px; }\n}\n\n@keyframes gal-jump-up {\n  0%, 100% { margin-top: 0; }\n  50% { margin-top: -22px; }\n}\n\n@keyframes gal-jump-down {\n  0%, 100% { margin-top: 0; }\n  50% { margin-top: 12px; }\n}\n\n.gal-cg {\n  z-index: 3;\n  background: #000;\n}\n\n.gal-cg img {\n  width: 100%;\n  height: 100%;\n  object-fit: cover;\n}\n\n.gal-location {\n  position: absolute;\n  z-index: 8;\n  top: 18px;\n  right: 18px;\n  padding: 7px 17px;\n  border: 2px solid rgb(255 154 158 / 60%);\n  border-radius: 999px;\n  background: rgb(255 255 255 / 86%);\n  box-shadow: 0 4px 15px rgb(0 0 0 / 15%);\n  font-weight: 700;\n  letter-spacing: .08em;\n}\n\n.gal-dialogue {\n  position: absolute;\n  z-index: 5;\n  right: 0;\n  bottom: 30px;\n  left: 0;\n  min-height: 31%;\n  max-height: 46%;\n  padding: 26px 6% 32px;\n  overflow-y: auto;\n  border-top: 2px solid rgb(255 255 255 / 82%);\n  background: linear-gradient(180deg, rgb(255 255 255 / 30%), rgb(255 255 255 / 95%) 22%);\n  backdrop-filter: blur(3px);\n  box-shadow: 0 -4px 16px rgb(0 0 0 / 7%);\n  transition: opacity 180ms ease;\n}\n\n.gal-speaker {\n  position: absolute;\n  top: -1px;\n  left: 5%;\n  padding: 5px 20px;\n  border: 2px solid rgb(255 255 255 / 90%);\n  border-radius: 999px;\n  background: linear-gradient(135deg, #ff9a9e, #fecfef);\n  box-shadow: 0 4px 12px rgb(255 154 158 / 40%);\n  color: #5c4b51;\n  font: 900 15px/1.3 system-ui, sans-serif;\n  letter-spacing: .14em;\n}\n\n.gal-text {\n  min-height: 2.7em;\n  margin: 8px 0 0;\n  color: #3a2c30;\n  font-size: var(--dialogue-font-size);\n  font-weight: 600;\n  line-height: 1.8;\n  letter-spacing: .04em;\n  white-space: pre-wrap;\n  text-shadow: 1px 1px 0 rgb(255 255 255 / 90%);\n}\n\n.gal-page {\n  position: absolute;\n  right: 16px;\n  bottom: 7px;\n  color: #936d78;\n  font: 12px/1.2 system-ui, sans-serif;\n}\n\n.gal-controls {\n  position: absolute;\n  z-index: 10;\n  right: 0;\n  bottom: 0;\n  left: 0;\n  height: 30px;\n  display: flex;\n  background: linear-gradient(90deg, rgb(255 182 193 / 96%), rgb(255 192 203 / 96%));\n  box-shadow: 0 -2px 10px rgb(255 105 135 / 15%);\n}\n\n.gal-controls button {\n  flex: 1;\n  min-width: 0;\n  padding: 0 4px;\n  overflow: hidden;\n  border: 0;\n  border-right: 1px solid rgb(255 255 255 / 42%);\n  background: transparent;\n  color: #fff;\n  font: 700 clamp(10px, 1.25vw, 14px)/1 system-ui, sans-serif;\n  text-overflow: ellipsis;\n  text-shadow: 0 1px 2px rgb(0 0 0 / 15%);\n  white-space: nowrap;\n}\n\n.gal-controls button:hover,\n.gal-controls button.active {\n  background: rgb(255 105 135 / 72%);\n}\n\n.gal-controls button:disabled,\n.gal-input-actions button:disabled,\n.gal-choice-list button:disabled {\n  cursor: default;\n  opacity: .45;\n}\n\nbutton:focus-visible,\ntextarea:focus-visible {\n  outline: 2px solid #fff;\n  outline-offset: -3px;\n}\n\n.gal-status {\n  position: absolute;\n  z-index: 20;\n  top: 50%;\n  left: 50%;\n  width: min(92%, 720px);\n  max-height: 86%;\n  padding: 18px;\n  overflow: auto;\n  border: 2px solid rgb(255 182 193 / 65%);\n  border-radius: 14px;\n  background: rgb(255 255 255 / 96%);\n  box-shadow: 0 14px 50px rgb(0 0 0 / 38%);\n  transform: translate(-50%, -50%);\n}\n\n.gal-display-panel {\n  position: absolute;\n  z-index: 20;\n  top: 50%;\n  left: 50%;\n  width: min(86%, 340px);\n  padding: 20px;\n  border: 2px solid rgb(255 182 193 / 70%);\n  border-radius: 14px;\n  background: rgb(255 255 255 / 96%);\n  box-shadow: 0 14px 50px rgb(0 0 0 / 38%);\n  transform: translate(-50%, -50%);\n  font-family: system-ui, sans-serif;\n}\n\n.gal-display-panel header {\n  margin-bottom: 14px;\n  color: #ff758c;\n}\n\n.gal-display-panel label {\n  display: grid;\n  grid-template-columns: 80px 1fr;\n  align-items: center;\n  gap: 10px;\n  margin: 14px 0;\n  color: #78545d;\n  font-weight: 700;\n}\n\n.gal-display-panel input {\n  width: 100%;\n  accent-color: #ff758c;\n}\n\n.gal-display-panel button,\n.gal-gallery header button,\n.gal-gallery-viewer button {\n  padding: 7px 14px;\n  border: 0;\n  border-radius: 6px;\n  background: #f4bdc8;\n  color: #63464e;\n}\n\n.gal-gallery {\n  position: absolute;\n  z-index: 21;\n  inset: 4%;\n  padding: 18px;\n  overflow: hidden;\n  border-radius: 14px;\n  background: rgb(20 13 17 / 94%);\n  box-shadow: 0 14px 50px rgb(0 0 0 / 48%);\n}\n\n.gal-gallery header {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  margin-bottom: 14px;\n  color: #fff;\n  font-family: system-ui, sans-serif;\n}\n\n.gal-gallery-grid {\n  height: calc(100% - 48px);\n  display: grid;\n  grid-template-columns: repeat(auto-fill, minmax(160px, 1fr));\n  gap: 12px;\n  overflow-y: auto;\n}\n\n.gal-gallery-grid > div {\n  position: relative;\n  min-height: 112px;\n  overflow: hidden;\n  border: 2px solid rgb(255 255 255 / 14%);\n  border-radius: 8px;\n  background: #080608;\n}\n\n.gal-gallery-grid img {\n  width: 100%;\n  height: 100%;\n  object-fit: cover;\n}\n\n.gal-gallery-grid button {\n  position: absolute;\n  inset: 0;\n  width: 100%;\n  border: 0;\n  background: linear-gradient(transparent 50%, rgb(0 0 0 / 86%));\n  color: #fff;\n  font: 700 12px/1.4 system-ui, sans-serif;\n  text-align: center;\n  padding: 62px 6px 5px;\n}\n\n.gal-gallery-grid button:disabled {\n  background: rgb(10 8 10 / 84%);\n  color: rgb(255 255 255 / 45%);\n}\n\n.gal-gallery-viewer {\n  position: absolute;\n  z-index: 25;\n  inset: 0;\n  display: grid;\n  place-items: center;\n  background: rgb(0 0 0 / 92%);\n}\n\n.gal-gallery-viewer img {\n  max-width: 94%;\n  max-height: 92%;\n  object-fit: contain;\n}\n\n.gal-gallery-viewer button {\n  position: absolute;\n  top: 12px;\n  right: 12px;\n  width: 36px;\n  height: 36px;\n  padding: 0;\n  border-radius: 50%;\n  font-size: 22px;\n}\n\n.gal-status header {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  margin-bottom: 14px;\n  color: #ff758c;\n  font-family: system-ui, sans-serif;\n}\n\n.gal-status header button {\n  width: 30px;\n  height: 30px;\n  border: 0;\n  border-radius: 50%;\n  background: #ffe1e7;\n  color: #7d4b57;\n}\n\n.gal-status-grid {\n  display: grid;\n  grid-template-columns: repeat(3, 1fr);\n  gap: 16px;\n}\n\n.gal-status-grid section + section {\n  padding-left: 16px;\n  border-left: 1px dashed #efb6c2;\n}\n\n.gal-status label,\n.gal-status-label {\n  display: flex;\n  justify-content: space-between;\n  margin: 8px 0;\n  color: #78545d;\n  font: 700 13px/1.5 system-ui, sans-serif;\n}\n\n.gal-status progress {\n  width: 100%;\n  accent-color: #ff758c;\n}\n\n.gal-melody {\n  color: #ff758c;\n  font-weight: 700;\n}\n\n.gal-voice {\n  padding: 10px;\n  border-radius: 8px;\n  background: #fff2f5;\n  font-size: 13px;\n  line-height: 1.6;\n}\n\n.gal-status dl,\n.gal-status dd {\n  margin: 0;\n}\n\n.gal-status dl div {\n  display: flex;\n  justify-content: space-between;\n  gap: 8px;\n  padding: 6px 0;\n  border-bottom: 1px solid #f6dce2;\n  font: 12px/1.5 system-ui, sans-serif;\n}\n\n.gal-status dd {\n  text-align: right;\n}\n\n.gal-turn-delta {\n  color: #a04d62;\n  font: 12px/1.5 system-ui, sans-serif;\n}\n\n.gal-choice-list {\n  position: absolute;\n  z-index: 12;\n  top: 48%;\n  left: 50%;\n  width: min(82%,