amp(12px, 1.4vw, 19px); }\n.gal-stage.font-80 { --dialogue-font-size: clamp(14px, 1.6vw, 22px); }\n.gal-stage.font-90 { --dialogue-font-size: clamp(16px, 1.8vw, 24px); }\n.gal-stage.font-100 { --dialogue-font-size: clamp(17px, 2vw, 27px); }\n.gal-stage.font-110 { --dialogue-font-size: clamp(18px, 2.2vw, 29px); }\n.gal-stage.font-120 { --dialogue-font-size: clamp(20px, 2.4vw, 32px); }\n.gal-stage.font-130 { --dialogue-font-size: clamp(21px, 2.6vw, 35px); }\n.gal-stage.font-140 { --dialogue-font-size: clamp(23px, 2.8vw, 38px); }\n.gal-stage.font-150 { --dialogue-font-size: clamp(25px, 3vw, 41px); }\n.gal-stage.character-60 { --character-scale: .6; }\n.gal-stage.character-70 { --character-scale: .7; }\n.gal-stage.character-80 { --character-scale: .8; }\n.gal-stage.character-90 { --character-scale: .9; }\n.gal-stage.character-100 { --character-scale: 1; }\n.gal-stage.character-110 { --character-scale: 1.1; }\n.gal-stage.character-120 { --character-scale: 1.2; }\n.gal-stage.character-130 { --character-scale: 1.3; }\n.gal-stage.character-140 { --character-scale: 1.4; }\n\n.gal-stage.effect-flash::after,\n.gal-stage.effect-black::after {\n  content: \"\";\n  position: absolute;\n  z-index: 30;\n  inset: 0;\n  pointer-events: none;\n}\n\n.gal-stage.effect-flash::after {\n  animation: gal-flash .25s ease-out;\n  background: #fff;\n}\n\n.gal-stage.effect-black::after {\n  background: #000;\n  opacity: 1;\n}\n\n@keyframes gal-flash {\n  from { opacity: .85; }\n  to { opacity: 0; }\n}\n\n@media (max-width: 720px) {\n  .gal-stage {\n    height: calc(100dvh - 116px);\n    min-height: 520px;\n    border-radius: 0;\n  }\n\n  .gal-character {\n    top: -2%;\n    height: 235%;\n  }\n\n  .gal-character-left { left: 24%; }\n  .gal-character-right { left: 76%; }\n\n  .gal-dialogue {\n    min-height: 36%;\n    max-height: 51%;\n    padding: 22px 4% 31px;\n  }\n\n  .gal-status-grid {\n    grid-template-columns: 1fr;\n  }\n\n  .gal-status-grid section + section {\n    padding-top: 10px;\n 