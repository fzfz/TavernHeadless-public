{
  "name": "@tavern/core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./node-graph": {
      "development": "./src/node-graph/browser.ts",
      "types": "./dist/node-graph/browser.d.ts",
      "import": "./dist/node-graph/browser.js",
      "default": "./dist/node-graph/browser.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -b && tsc -p tsconfig.test.json",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "3.0.135",
    "@ai-sdk/openai": "3.0.131",
    "@tavern/shared": "workspace:*",
    "ai": "6.0.315",
    "emittery": "1.2.1",
    "lru-cache": "11.5.3",
    "nanoid": "5.1.16",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "typescript": "5.9.3",
    "vitest": "4.1.12"
  },
  "files": [
    "dist"
  ]
}
