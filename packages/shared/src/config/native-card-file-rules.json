      "parseInt",
      "Promise",
      "RangeError",
      "RegExp",
      "Set",
      "String",
      "TypeError",
      "undefined"
    ],
    "blockedProperties": [
      "constructor",
      "__proto__"
    ],
    "imports": {
      "relativeOnly": true,
      "extensions": [
        ".js",
        ".json"
      ]
    }
  },
