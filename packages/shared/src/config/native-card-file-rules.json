{
  "format": "tavern_headless_role_package",
  "frontendResourceAttributes": [
    "src",
    "srcset",
    "href",
    "poster",
    "data",
    "action",
    "formaction",
    "background",
    "xlink:href"
  ],
  "creationTemplates": [
    {
      "id": "openingText",
      "label": "开场正文",
      "pathTemplate": "openings/{openingId}.txt",
      "mediaType": "text/plain",
      "purpose": "data",
      "content": ""
    },
    {
      "id": "openingInitialState",
      "label": "开场初始变量",
      "pathTemplate": "state/initial/{openingId}.json",
      "mediaType": "application/json",
      "purpose": "data",
      "content": {}
    },
    {
      "id": "worldbookIndex",
      "label": "世界书",
      "pathTemplate": "worldbooks/{bookId}/book.json",
      "mediaType": "application/json",
      "purpose": "data",
      "content": {
        "name": "新世界书",
        "entryFiles": [],
        "scanDepth": 2,
        "caseSensitive": false,
        "matchWholeWords": false,
        "recursive": false,
        "maxRecursionSteps": 1
      }
    },
    {
      "id": "worldbookEntry",
      "label": "世界书条目",
      "pathTemplate": "worldbooks/{bookId}/entries/{entryId}.json",
      "mediaType": "application/json",
      "purpose": "data",
      "content": {
        "uid": 1,
        "key": [],
        "keysecondary": [],
        "selective": false,
        "selectiveLogic": 0,
        "constant": false,
        "content": "",
        "comment": "",
        "position": 0,
        "order": 100,
        "depth": 4,
        "role": 0,
        "disable": false,
        "scanDepth": null,
        "caseSensitive": null,
        "matchWholeWords": null
      }
    },
    {
      "id": "stateSchema",
      "label": "变量结构",
      "pathTemplate": "state/schema.json",
      "mediaType": "application/json",
      "purpose": "data",
      "content": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {},
        "additionalProperties": false
      }
    },
    {
      "id": "stateUpdateProfile",
      "label": "变量更新 Agent 配置",
      "pathTemplate": "agents/state-update/profile.json",
      "mediaType": "application/json",
      "purpose": "data",
      "content": {
        "updaterPrompt": "",
        "writablePaths": [],
        "stateSchemaFile": "state/schema.json",
        "ruleFiles": []
      }
    },
    {
      "id": "stateUpdateRules",
      "label": "变量更新规则",
      "pathTemplate": "agents/state-update/rules.json",
      "mediaType": "application/json",
      "purpose": "data",
      "content": {
        "rules": []
      }
    },
    {
      "id": "stateUpdateRulesText",
      "label": "变量更新文本规则",
      "pathTemplate": "agents/state-update/rules.txt",
      "mediaType": "text/plain",
      "purpose": "data",
      "content": ""
    },
    {
      "id": "deriveModule",
      "label": "变量派生模块",
      "pathTemplate": "backend/variable-tools/{name}.js",
      "mediaType": "text/javascript",
      "purpose": "server_script",
      "content": "export function derive(context) {\n  return context.candidate;\n}\n"
    },
    {
      "id": "validatorModule",
      "label": "变量校验模块",
      "pathTemplate": "backend/validators/{name}.js",
      "mediaType": "text/javascript",
      "purpose": "server_script",
      "content": "export function validate(context) {\n  return { issues: [] };\n}\n"
    },
    {
      "id": "controllerConfig",
      "label": "提示词控制器配置",
      "pathTemplate": "backend/controllers/config.json",
      "mediaType": "application/json",
      "purpose": "data",
      "content": {
        "modulePath": "backend/controllers/prompt.js",
        "variableRoot": "state",
        "variableMacros": [],
        "controllerEntries": [],
        "updaterEntries": []
      }
    },
    {
      "id": "controllerModule",
      "label": "提示词控制器模块",
      "pathTemplate": "backend/controllers/{name}.js",
      "mediaType": "text/javascript",
      "purpose": "server_script",
      "content": "export function renderController(context) {\n  return { text: \"\" };\n}\n"
    },
    {
      "id": "regexProfile",
      "label": "正则规则",
      "pathTemplate": "regex/{name}.json",
      "mediaType": "application/json",
      "purpose": "data",
      "content": []
    },
    {
      "id": "frontendManifest",
      "label": "前端入口配置",
      "pathTemplate": "frontend/manifest.json",
      "mediaType": "application/json",
      "purpose": "data",
      "content": {
        "apiVersion": 1,
        "html": "frontend/index.html",
        "css": "frontend/style.css",
        "script": "frontend/main.js",
        "assets": {},
        "data": {}
      }
    },
    {
      "id": "frontendHtml",
      "label": "前端 HTML",
      "pathTemplate": "frontend/index.html",
      "mediaType": "text/html",
      "purpose": "template",
      "content": "<main></main>\n"
    },
    {
      "id": "frontendCss",
      "label": "前端 CSS",
      "pathTemplate": "frontend/style.css",
      "mediaType": "text/css",
      "purpose": "template",
      "content": ""
    },
    {
      "id": "frontendModule",
      "label": "前端 JavaScript",
      "pathTemplate": "frontend/main.js",
      "mediaType": "text/javascript",
      "purpose": "browser_script",
      "content": "export function mount({ api }) {\n  return () => {};\n}\n"
    },
    {
      "id": "dataJson",
      "label": "JSON 数据",
      "pathTemplate": "data/{name}.json",
      "mediaType": "application/json",
      "purpose": "data",
      "content": {}
    }
  ],
