  "backendModuleApi": {
    "exports": [
      {
        "name": "derive",
        "directory": "backend/variable-tools/",
        "contextFields": [
          "before",
          "candidate",
          "sourceMessages",
          "priorFacts",
          "floorBefore",
          "facts",
          "toolEvidence"
        ],
        "async": false
      },
      {
        "name": "validate",
        "directory": "backend/validators/",
        "contextFields": [
          "before",
          "candidate",
          "sourceMessages",
          "priorFacts",
          "floorBefore",
          "facts",
          "toolEvidence"
        ],
        "async": false
      },
      {
        "name": "renderController",
        "directory": "backend/controllers/",
        "contextFields": [
          "bookId",
          "entryId",
          "variables",
          "characterBook"
        ],
        "async": true
      }
    ],
    "globals": [
      "Array",
      "Boolean",
      "BigInt",
      "Error",
      "Infinity",
      "isFinite",
      "isNaN",
      "JSON",
