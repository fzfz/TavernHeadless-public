  "issueMessages": {
    "NATIVE_CARD_CHARACTER_INVALID": {
      "message": "人物资料格式不正确。",
      "action": "请按 character.json 的字段定义修正人物资料。"
    },
    "NATIVE_CARD_DEFAULT_OPENING_AUDIENCE_INVALID": {
      "message": "默认开场不适用于所指定的会话类型。",
      "action": "请选择适用于该会话类型的开场，或修正开场 audience 字段。"
    },
    "NATIVE_CARD_DEFAULT_OPENING_MISSING": {
      "message": "默认开场标识没有对应的开场。",
      "action": "请补齐 openings.json 中的开场，或修正默认开场标识。"
    },
    "NATIVE_CARD_DEFAULT_OPENING_REQUIRED": {
      "message": "开场列表缺少适用会话类型的默认开场。",
      "action": "请在 openings.json 的 defaultOpeningIds 中选择默认开场。"
    },
    "NATIVE_CARD_FILE_ENCODING_INVALID": {
      "message": "文本文件不是有效的 UTF-8 编码。",
      "action": "请将该文件另存为 UTF-8 后重新上传。"
    },
    "NATIVE_CARD_FILE_EXTENSION_INVALID": {
      "message": "文件扩展名不符合所在目录的文件规则。",
      "action": "请按目录规则修改扩展名并同步引用。"
    },
    "NATIVE_CARD_FILE_FEATURE_DISABLED": {
      "message": "文件依赖的角色功能尚未在配置中启用。",
      "action": "请补齐对应功能配置，或移除未使用的文件及其引用。"
    },
    "NATIVE_CARD_FILE_JSON_INVALID": {
      "message": "文件内容不是有效的 JSON。",
      "action": "请检查引号、逗号和括号，修正 JSON 语法后重新检查。"
    },
    "NATIVE_CARD_FILE_MEDIA_TYPE_MISMATCH": {
      "message": "清单中的媒体类型不符合该文件的目录规则。",
      "action": "请按文件格式修正 manifest.json 中的 mediaType。"
    },
    "NATIVE_CARD_FILE_MISSING": {
      "message": "角色包缺少必需文件。",
      "action": "请补齐所列路径的文件后重新检查。"
    },
    "NATIVE_CARD_FILE_NOT_REGISTERED": {
      "message": "包内文件没有登记在清单中。",
      "action": "请在 manifest.json 的 files 中登记该文件，或移除该文件。"
    },
    "NATIVE_CARD_FILE_PATH_UNSUPPORTED": {
      "message": "文件路径不属于当前包格式支持的目录。",
      "action": "请将文件移动到规则规定的目录并同步引用。"
    },
    "NATIVE_CARD_FILE_PURPOSE_MISMATCH": {
      "message": "清单中的文件用途不符合该文件的目录规则。",
      "action": "请按目录规则修正 manifest.json 中的 purpose。"
    },
    "NATIVE_CARD_FILE_RULE_SCHEMA_UNKNOWN": {
      "message": "文件规则引用了系统中未登记的 schema。",
      "action": "请管理员核对文件规则配置与共享 schema 的版本。"
    },
    "NATIVE_CARD_FILE_SCHEMA_INVALID": {
      "message": "文件字段不符合对应 schema 的类型或约束。",
      "action": "请按所列字段位置和格式详情修正内容后重新检查。"
    },
    "NATIVE_CARD_FIXED_PATH_INVALID": {
      "message": "配置中的固定文件路径不符合原生包格式。",
      "action": "请使用规则规定的固定路径，并补齐对应文件。"
    },
    "NATIVE_CARD_FORMAT_VERSION_UNSUPPORTED": {
      "message": "服务器不支持角色包声明的格式版本。",
      "action": "请使用服务器支持的包版本，或通过明确的迁移程序转换后导入。"
    },
    "NATIVE_CARD_INITIAL_STATE_MISSING": {
      "message": "开场引用的初始变量文件不存在。",
      "action": "请补齐 initialStateFile 指向的文件，或修正该路径。"
    },
    "NATIVE_CARD_MANIFEST_INVALID": {
      "message": "根 manifest.json 的结构不符合原生包格式。",
      "action": "请按原生包清单 schema 修正根清单后重新检查。"
    },
    "NATIVE_CARD_MANIFEST_PATH_DUPLICATE": {
      "message": "清单多次登记了同一路径。",
      "action": "请在 manifest.json 的 files 中为每个文件保留一条记录。"
    },
    "NATIVE_CARD_MANIFEST_SELF_REFERENCE": {
      "message": "根清单将自身登记为普通包文件。",
      "action": "请从 manifest.json 的 files 中移除 manifest.json 记录。"
    },
    "NATIVE_CARD_OPENINGS_INVALID": {
      "message": "开场配置的结构不符合原生包格式。",
      "action": "请按 openings.json 的字段定义修正开场配置。"
    },
    "NATIVE_CARD_OPENING_ID_DUPLICATE": {
      "message": "多个开场使用了同一标识。",
      "action": "请为每个开场指定唯一 id，并同步默认开场引用。"
    },
    "NATIVE_CARD_OPENING_TEXT_MISSING": {
      "message": "开场引用的正文文件不存在。",
      "action": "请补齐 textFile 指向的正文文件，或修正该路径。"
    },
    "NATIVE_CARD_PATH_DUPLICATE": {
      "message": "角色包包含重复的文件路径。",
      "action": "请为文件使用唯一的包内路径后重新打包。"
    },
    "NATIVE_CARD_PATH_INVALID": {
      "message": "文件路径包含原生包不允许的片段或字符。",
      "action": "请使用包内相对路径，移除越界片段并同步引用。"
    },
    "NATIVE_CARD_REFERENCE_ENTRY_MISSING": {
      "message": "配置引用的世界书条目不存在。",
      "action": "请在指定世界书中补齐条目，或修正 bookId 和 entryId。"
    },
    "NATIVE_CARD_REFERENCE_MISSING": {
      "message": "配置引用的包内文件不存在。",
      "action": "请补齐所列文件，或将引用改为已有的包内路径。"
    },
    "NATIVE_CARD_REFERENCE_SCOPE_INVALID": {
      "message": "文件引用超出了该字段允许的目录范围。",
      "action": "请将引用改为该字段规定目录中的文件。"
    },
    "NATIVE_CARD_REFERENCE_WORLDBOOK_MISSING": {
      "message": "配置引用的世界书标识不存在。",
      "action": "请登记对应世界书，或修正引用中的 bookId。"
    },
    "NATIVE_CARD_WORLDBOOK_ENTRY_SCOPE_INVALID": {
      "message": "世界书引用了其他世界书目录中的条目文件。",
      "action": "请将条目文件放入所属世界书目录，并修正该书的条目路径。"
    },
    "NATIVE_CARD_WORLDBOOK_ENTRY_UNREFERENCED": {
      "message": "世界书目录中的条目没有被所属世界书登记。",
      "action": "请在该书 book.json 的条目列表中登记文件，或移除未使用的条目文件。"
    },
    "NATIVE_CARD_WORLDBOOK_FILE_DUPLICATE": {
      "message": "多个世界书登记项指向同一文件。",
      "action": "请为每本世界书指定独立的 book.json 路径。"
    },
    "NATIVE_CARD_WORLDBOOK_ID_DUPLICATE": {
      "message": "角色配置重复登记了世界书标识。",
      "action": "请为各世界书使用唯一 id 并同步引用。"
    },
    "NATIVE_CARD_WORLDBOOK_PATH_INVALID": {
      "message": "世界书路径与其所属标识不一致。",
      "action": "请使用 worldbooks/<bookId>/book.json 并同步角色配置。"
    },
    "NATIVE_CARD_WORLDBOOK_UID_DUPLICATE": {
      "message": "同一本世界书中的多个条目使用了同一 uid。",
      "action": "请在该世界书内为条目分配唯一 uid，并同步条目引用。"
    }
  }
