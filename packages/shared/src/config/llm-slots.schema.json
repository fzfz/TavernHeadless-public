{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["instanceSlots", "modelSlots", "defaultStateModelSlots", "stateUpdaterSlot"],
  "properties": {
    "instanceSlots": { "$ref": "#/$defs/slotList" },
    "modelSlots": { "$ref": "#/$defs/slotList" },
    "defaultStateModelSlots": { "$ref": "#/$defs/slotList" },
    "stateUpdaterSlot": { "type": "string", "minLength": 1 }
  },
  "additionalProperties": false,
  "$defs": {
    "slotList": { "type": "array", "items": { "type": "string", "minLength": 1 }, "minItems": 1, "uniqueItems": true }
  }
}
