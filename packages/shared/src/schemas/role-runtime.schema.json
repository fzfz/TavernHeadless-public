        "text": {
          "type": "string"
        },
        "floorId": {
          "type": "string",
          "minLength": 1
        },
        "streamId": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "const": "completed"
        }
      },
      "required": ["id", "role", "text", "floorId", "streamId", "status"],
      "additionalProperties": false
    },
