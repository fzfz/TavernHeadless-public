{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Character script runtime proposed contract",
  "definitions": {
    "package": {
      "type": "object",
      "properties": {
        "apiVersion": {
          "const": 1
        },
        "html": {
          "type": "string",
          "minLength": 1
        },
        "css": {
          "type": "string",
          "minLength": 1
        },
        "script": {
          "type": "string",
          "minLength": 1
        },
        "assets": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "kind": {
                "enum": ["image", "audio"]
              },
              "file": {
                "type": "string",
                "minLength": 1
              },
              "label": {
                "type": "string",
                "minLength": 1
              },
              "tags": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "uniqueItems": true
              }
            },
            "required": ["kind", "file", "label", "tags"],
            "additionalProperties": false
          },
          "propertyNames": {
            "type": "string",
            "minLength": 1
          }
        },
        "data": {
          "type": "object",
          "additionalProperties": true
        },
        "floorHtml": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": ["apiVersion", "html", "css", "script", "assets", "data"],
      "additionalProperties": false
    },
    "record": {
      "type": "object",
      "properties": {
        "sessionId": {
          "type": "string",
          "minLength": 1
        },
        "branchId": {
          "type": "string",
          "minLength": 1
        },
        "floorId": {
          "type": ["string", "null"],
          "minLength": 1
        },
        "attemptId": {
          "type": ["string", "null"],
          "minLength": 1
        },
        "versionId": {
          "type": "string",
          "minLength": 1
        },
        "snapshotId": {
          "type": "string",
          "minLength": 1
        },
        "parentSnapshotId": {
          "type": ["string", "null"],
          "minLength": 1
        },
        "variables": {
          "type": "object",
          "additionalProperties": true
        },
        "source": {
          "$ref": "#/definitions/snapshotSource"
        }
      },
      "required": [
        "sessionId",
        "branchId",
        "floorId",
        "attemptId",
        "versionId",
        "snapshotId",
        "parentSnapshotId",
        "variables",
        "source"
      ],
      "additionalProperties": false,
      "oneOf": [
        {
          "properties": {
            "floorId": {
              "type": "null"
            },
            "attemptId": {
              "type": "null"
            },
            "parentSnapshotId": {
              "type": "null"
            },
            "source": {
              "type": "object",
              "properties": {
                "kind": {
                  "enum": ["initial"]
                }
              }
            }
          }
        },
        {
          "properties": {
            "floorId": {
              "type": "string",
              "minLength": 1
            },
            "attemptId": {
              "type": "string",
              "minLength": 1
            },
            "parentSnapshotId": {
              "type": "string",
              "minLength": 1
            },
            "source": {
              "type": "object",
              "properties": {
                "kind": {
                  "enum": ["floor", "job"]
                }
              }
            }
          }
        },
        {
          "properties": {
            "source": {
              "type": "object",
              "properties": {
                "kind": {
                  "enum": ["manual"]
                }
              }
            }
          },
          "oneOf": [
            {
              "properties": {
                "floorId": {
                  "type": "null"
                },
                "attemptId": {
                  "type": "null"
                },
                "parentSnapshotId": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            {
              "properties": {
                "floorId": {
                  "type": "string",
                  "minLength": 1
                },
                "attemptId": {
                  "type": "string",
                  "minLength": 1
                },
                "parentSnapshotId": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          ]
        }
      ]
    },
    "error": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1
        },
        "message": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": ["code", "message"],
      "additionalProperties": false
    },
    "turnCommit": {
      "type": "object",
      "properties": {
        "eventId": {
          "type": "string",
          "minLength": 1
        },
        "sessionId": {
          "type": "string",
          "minLength": 1
        },
        "branchId": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": ["generated", "retried", "regenerated"]
        },
        "previousCurrentSnapshotId": {
          "type": "string",
          "minLength": 1
        },
        "before": {
          "$ref": "#/definitions/record"
        },
        "after": {
          "allOf": [
            {
              "$ref": "#/definitions/record"
            },
            {
              "properties": {
                "floorId": {
                  "type": "string",
                  "minLength": 1
                },
                "attemptId": {
                  "type": "string",
                  "minLength": 1
                },
                "source": {
                  "type": "object",
                  "properties": {
                    "kind": {
                      "const": "floor"
                    }
                  }
                }
              },
              "type": "object"
            }
          ]
        }
      },
      "required": [
        "eventId",
        "sessionId",
        "branchId",
        "kind",
        "previousCurrentSnapshotId",
        "before",
        "after"
      ],
      "additionalProperties": false
    },
    "floorPage": {
      "type": "object",
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "floorId": {
                "type": "string",
                "minLength": 1
              },
              "floorNo": {
                "type": "integer",
                "minimum": 0
              },
              "state": {
                "enum": ["draft", "generating", "committed", "failed"]
              }
            },
            "required": ["floorId", "floorNo", "state"],
            "additionalProperties": false
          }
        },
        "nextCursor": {
          "type": ["string", "null"],
          "minLength": 1
        }
      },
      "required": ["items", "nextCursor"],
      "additionalProperties": false
    },
    "snapshotPointer": {
      "type": "object",
      "properties": {
        "snapshotId": {
          "type": "string",
          "minLength": 1
        },
        "floorId": {
          "type": ["string", "null"],
          "minLength": 1
        },
        "attemptId": {
          "type": ["string", "null"],
          "minLength": 1
        }
      },
      "required": ["snapshotId", "floorId", "attemptId"],
      "additionalProperties": false
    },
    "snapshotPage": {
      "type": "object",
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/snapshotPointer"
          }
        },
        "nextCursor": {
          "type": ["string", "null"],
          "minLength": 1
        }
      },
      "required": ["items", "nextCursor"],
      "additionalProperties": false
    },
    "historyCursor": {
      "type": "object",
      "properties": {
        "version": {
          "const": 1
        },
        "resource": {
          "enum": ["snapshots", "floors"]
        },
        "sessionId": {
          "type": "string",
          "minLength": 1
        },
        "branchId": {
          "type": "string",
          "minLength": 1
        },
        "beforeNo": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": ["version", "resource", "sessionId", "branchId", "beforeNo"],
      "additionalProperties": false
    },
    "chatSetDraftParams": {
      "type": "object",
      "properties": {
        "text": {
          "type": "string"
        }
      },
      "required": ["text"],
      "additionalProperties": false
    },
    "chatSetDraftResult": {
      "type": "null"
    },
    "chatSendParams": {
      "type": "object",
      "properties": {
        "text": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": ["text"],
      "additionalProperties": false
    },
    "chatSendResult": {
      "type": "object",
      "properties": {
        "snapshotId": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": ["snapshotId"],
      "additionalProperties": false
    },
    "historySelectParams": {
      "type": "object",
      "properties": {
        "snapshotId": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": ["snapshotId"],
      "additionalProperties": false
    },
    "historySelectResult": {
      "type": "object",
      "properties": {
        "snapshotId": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": ["snapshotId"],
      "additionalProperties": false
    },
    "historyLatestParams": {
      "type": "object",
      "properties": {},
      "required": [],
      "additionalProperties": false
    },
    "historyLatestResult": {
      "type": "object",
      "properties": {
        "snapshotId": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": ["snapshotId"],
      "additionalProperties": false
    },
    "variablesGetSnapshotParams": {
      "type": "object",
