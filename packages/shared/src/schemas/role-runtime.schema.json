    },
    "historyListSnapshotsParams": {
      "type": "object",
      "properties": {
        "branchId": {
          "type": "string",
          "minLength": 1
        },
        "cursor": {
          "type": "string",
          "minLength": 1
        },
        "limit": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": ["branchId"],
      "additionalProperties": false
    },
    "historyListSnapshotsResult": {
      "$ref": "#/definitions/snapshotPage"
    },
    "messagesListFloorsParams": {
      "$ref": "#/definitions/historyListSnapshotsParams"
    },
    "messagesListFloorsResult": {
      "$ref": "#/definitions/floorPage"
    },
    "layoutRegistration": {
      "type": "object",
      "properties": {
        "root": {
          "type": "string",
          "minLength": 1
        },
        "elements": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "object",
            "properties": {
              "selector": {
                "type": "string",
                "minLength": 1
              },
              "kind": {
                "enum": [
                  "image",
                  "text",
                  "progress",
                  "control",
                  "container",
                  "fill"
                ]
              }
            },
            "required": ["selector", "kind"],
            "additionalProperties": false
          }
        }
      },
      "required": ["elements"],
      "additionalProperties": false
    },
    "elementUpdate": {
      "type": "object",
      "properties": {
        "visible": {
          "type": "boolean"
        },
        "classes": {
          "type": "object",
          "additionalProperties": {
            "type": "boolean"
          },
          "propertyNames": {
            "type": "string",
            "pattern": "^[^\\t\\n\\f\\r ]+$"
          }
        },
        "asset": {
          "type": "string",
          "minLength": 1
        },
        "alt": {
          "type": "string"
        },
        "text": {
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "string"
            }
          ]
        },
        "min": {
          "type": "number"
        },
        "max": {
          "type": "number"
        },
        "disabled": {
          "type": "boolean"
        },
        "checked": {
          "type": "boolean"
        },
        "percent": {
          "type": "number",
          "minimum": 0
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "layoutPatch": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/definitions/elementUpdate"
      }
    },
    "assetsListParams": {
      "type": "object",
      "properties": {
        "kind": {
          "enum": ["image", "audio"]
        },
        "tag": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "assetMetadata": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": ["image", "audio"]
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      },
      "required": ["id", "kind", "label", "tags"],
      "additionalProperties": false
    },
    "assetsListResult": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/assetMetadata"
      }
    },
    "mediaPlayParams": {
      "type": "object",
      "properties": {
        "asset": {
          "type": "string",
          "minLength": 1
        },
        "channel": {
          "type": "string",
          "minLength": 1
        },
        "loop": {
          "type": "boolean",
          "default": false
        },
        "volume": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "default": 1
        }
      },
      "required": ["asset", "channel"],
      "additionalProperties": false
    },
    "mediaPlayResult": {
      "type": "null"
    },
    "timerAfterDelay": {
      "type": "integer",
      "minimum": 0
    },
    "timerEveryDelay": {
      "type": "integer",
      "minimum": 1
    },
    "snapshotSource": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "initial"
            },
            "runId": {
              "type": "null"
            },
            "jobId": {
              "type": "null"
            }
          },
          "required": ["kind", "runId", "jobId"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "floor"
            },
            "runId": {
              "type": "string",
              "minLength": 1
            },
            "jobId": {
              "type": "null"
            }
          },
          "required": ["kind", "runId", "jobId"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "job"
            },
            "runId": {
              "type": ["string", "null"],
              "minLength": 1
            },
            "jobId": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": ["kind", "runId", "jobId"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "manual"
            },
            "runId": {
              "type": "null"
            },
            "jobId": {
              "type": "null"
            }
          },
          "required": ["kind", "runId", "jobId"],
          "additionalProperties": false
        }
      ]
    },
    "textStreamFilter": {
      "type": "object",
      "properties": {
        "floorId": {
          "type": "string",
          "minLength": 1
        },
        "streamId": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "textStreamEvent": {
      "type": "object",
      "properties": {
        "sessionId": {
          "type": "string",
          "minLength": 1
        },
        "branchId": {
          "type": "string",
          "minLength": 1
        },
        "floorId": {
          "type": "string",
          "minLength": 1
        },
        "attemptId": {
          "type": "string",
          "minLength": 1
        },
        "streamId": {
          "type": "string",
          "minLength": 1
        },
        "runId": {
          "type": ["string", "null"],
          "minLength": 1
        },
        "jobId": {
          "type": ["string", "null"],
          "minLength": 1
        },
        "messageId": {
          "type": ["string", "null"],
          "minLength": 1
        },
        "revision": {
          "type": "integer",
          "minimum": 0
        },
        "type": {
          "enum": ["snapshot", "start", "update", "end", "error", "cancelled"]
        },
        "status": {
          "enum": ["streaming", "completed", "failed", "cancelled"]
        },
        "text": {
          "type": "string"
        },
        "error": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/definitions/error"
            }
          ]
        }
      },
      "required": [
        "sessionId",
        "branchId",
        "floorId",
        "attemptId",
        "streamId",
        "runId",
        "jobId",
        "messageId",
        "revision",
        "type",
        "status",
        "text",
        "error"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "anyOf": [
            {
              "properties": {
                "runId": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            {
              "properties": {
                "jobId": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          ]
        },
        {
          "oneOf": [
            {
              "properties": {
                "type": {
                  "const": "snapshot"
                }
              }
            },
            {
              "properties": {
                "type": {
                  "enum": ["start", "update"]
                },
                "status": {
                  "const": "streaming"
                }
              }
            },
            {
              "properties": {
                "type": {
                  "const": "end"
                },
                "status": {
                  "const": "completed"
                }
              }
            },
            {
              "properties": {
                "type": {
                  "const": "error"
                },
                "status": {
                  "const": "failed"
                }
              }
            },
            {
              "properties": {
                "type": {
                  "const": "cancelled"
                },
                "status": {
                  "const": "cancelled"
                }
              }
            }
          ]
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "failed"
              }
            }
          },
          "then": {
            "properties": {
              "error": {
                "$ref": "#/definitions/error"
              }
            }
          },
          "else": {
            "properties": {
              "error": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "resourcePolicy": {
      "$ref": "https://tavern-headless.local/runtime-policy.schema.json"
    },
    "message": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
