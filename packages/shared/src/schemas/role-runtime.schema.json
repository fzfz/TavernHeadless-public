        },
        "text": {
          "$ref": "#/definitions/elementUpdate/properties/text"
        },
        "value": {
          "$ref": "#/definitions/elementUpdate/properties/value"
        },
        "disabled": {
          "$ref": "#/definitions/elementUpdate/properties/disabled"
        },
        "checked": {
          "$ref": "#/definitions/elementUpdate/properties/checked"
        }
