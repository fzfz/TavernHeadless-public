          "$ref": "#/definitions/elementUpdate/properties/classes"
        }
      },
      "additionalProperties": false
    },
    "variablesRecalculateLatestParams": {
      "type": "object",
      "properties": {
        "branchId": {
          "type": "string",
          "minLength": 1
        },
        "floorId": {
          "type": "string",
          "minLength": 1
        },
        "expectedSnapshotId": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": ["branchId", "floorId", "expectedSnapshotId"],
