      "maximum": 9007199254740991
    },
    "caseSensitive": {
      "type": "boolean"
    },
    "matchWholeWords": {
      "type": "boolean"
    },
    "recursive": {
      "type": "boolean"
    },
    "maxRecursionSteps": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "extra": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {}
    }
  },
  "required": [
    "name",
    "entryFiles",
    "scanDepth",
    "caseSensitive",
    "matchWholeWords",
    "recursive",
    "maxRecursionSteps"
  ],
  "additionalProperties": false,
  "$comment": "Generated from schema.ts by scripts/generate-native-card-schemas.ts."
}
