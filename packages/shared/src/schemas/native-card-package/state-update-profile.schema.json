{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "updaterPrompt": {
      "type": "string"
    },
    "presetRef": {
      "type": "object",
      "properties": {
        "presetId": {
          "type": "string",
          "minLength": 1
        },
        "presetVersionId": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "presetId",
        "presetVersionId"
      ],
      "additionalProperties": false
    },
    "writablePaths": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^\\/.*"
      }
    },
    "derivedPaths": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^\\/.*"
      }
    },
    "controllerOwnedPaths": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^\\/.*"
      }
    },
    "initialDescriptionPaths": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^\\/.*"
      }
    },
    "stateSchemaFile": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!.*(?:^|\\/)\\.{1,2}(?:\\/|$))(?!.*[\\\\:\\u0000])[^/]+(?:\\/[^/]+)*$"
    },
    "ruleFiles": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "^(?!.*(?:^|\\/)\\.{1,2}(?:\\/|$))(?!.*[\\\\:\\u0000])[^/]+(?:\\/[^/]+)*$"
      }
    },
    "deriveScript": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!.*(?:^|\\/)\\.{1,2}(?:\\/|$))(?!.*[\\\\:\\u0000])[^/]+(?:\\/[^/]+)*$"
    },
    "validateScript": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!.*(?:^|\\/)\\.{1,2}(?:\\/|$))(?!.*[\\\\:\\u0000])[^/]+(?:\\/[^/]+)*$"
    },
    "moduleFiles": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "^(?!.*(?:^|\\/)\\.{1,2}(?:\\/|$))(?!.*[\\\\:\\u0000])[^/]+(?:\\/[^/]+)*$"
      }
    },
    "factsSchema": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {}
    },
    "maxTokens": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "updaterReasoning": {
      "type": "object",
      "properties": {
        "effort": {
          "type": "string",
          "enum": [
            "none",
            "low",
            "medium",
            "high"
          ]
        }
      },
      "required": [
        "effort"
      ],
      "additionalProperties": {}
    },
    "extra": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {}
    }
  },
  "required": [
    "updaterPrompt",
    "writablePaths"
  ],
  "additionalProperties": false,
  "$comment": "Generated from schema.ts by scripts/generate-native-card-schemas.ts."
}
