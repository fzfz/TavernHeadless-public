{
  "name": "tavern-headless",
  "version": "0.1.0",
  "private": true,
  "description": "Backend-first AI RP engine with SillyTavern compatibility",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": "22.23.4",
    "pnpm": "10.34.5"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "node scripts/environments/cli.mjs start --env dev",
    "environment": "node scripts/environments/cli.mjs",
    "test:environments": "node --test scripts/environments/*.test.mjs",
    "build": "pnpm -r --if-present build",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "vitest",
    "test:ci": "vitest run --reporter=verbose",
    "test:coverage": "vitest run --coverage",
    "test:ci:coverage": "vitest run --coverage --reporter=dot --coverage.reporter=text-summary --coverage.reporter=json-summary",
    "smoke:api": "pnpm --filter @tavern/api smoke",
    "lint": "eslint .",
    "lint:full": "eslint . && prettier --check .",
    "lint:fix": "eslint . --fix && prettier --write .",
    "docs:lint": "node scripts/docs-lint.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "openapi:export": "pnpm --filter @tavern/api openapi:export -- packages/shared/src/generated/openapi.json",
    "sdk:generate": "pnpm openapi:export && pnpm exec openapi-typescript packages/shared/src/generated/openapi.json --output packages/shared/src/generated/openapi-types.ts",
    "sdk:check": "pnpm --filter @tavern/api openapi:export -- packages/shared/src/generated/.openapi.check.json && pnpm exec openapi-typescript packages/shared/src/generated/.openapi.check.json --output packages/shared/src/generated/.openapi-types.check.ts && tsx scripts/check-sdk-generated.ts",
    "clean": "rimraf node_modules coverage .turbo",
    "postinstall": "node scripts/patch-vitepress-build.mjs",
    "prepare": "husky",
    "docs:generate-agent": "tsx scripts/generate-agent-artifacts.ts",
    "docs:generate-skills": "tsx scripts/generate-skill-artifacts.ts",
    "docs:dev": "pnpm --filter @tavern/docs dev",
    "docs:build": "pnpm docs:generate-agent && pnpm docs:generate-skills && pnpm --filter @tavern/docs build",
    "docs:preview": "pnpm --filter @tavern/docs preview",
    "test:dependencies": "node --test scripts/dependency-compatibility.node-test.mjs"
  },
  "dependencies": {
    "@ai-sdk/openai": "3.0.131",
    "@fastify/cors": "11.2.0",
    "@fastify/sensible": "6.0.7",
    "ai": "6.0.315",
    "better-sqlite3": "12.8.0",
    "bowser": "2.12.1",
    "drizzle-orm": "0.45.2",
    "emittery": "1.2.1",
    "fastify": "5.12.7",
    "lru-cache": "11.5.3",
    "moment": "2.31.0",
    "nanoid": "5.1.16",
    "pinia": "2.3.1",
    "seedrandom": "3.0.5",
    "vue": "3.5.44",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@commitlint/cli": "19.8.1",
    "@commitlint/config-conventional": "19.8.1",
    "@eslint/js": "9.39.5",
    "@types/better-sqlite3": "7.6.13",
    "@types/node": "22.20.5",
    "@vitejs/plugin-vue": "5.2.4",
    "@vitest/coverage-v8": "4.1.12",
    "ajv": "8.18.0",
    "autoprefixer": "10.6.1",
    "drizzle-kit": "0.31.11",
    "esbuild": "0.28.1",
    "eslint": "9.39.5",
    "eslint-config-prettier": "9.1.2",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-vue": "10.11.1",
    "globals": "14.0.0",
    "husky": "9.1.7",
    "lint-staged": "15.5.2",
    "markdownlint-cli2": "0.24.0",
    "msw": "2.15.0",
    "openapi-typescript": "7.13.0",
    "postcss": "8.5.31",
    "prettier": "3.9.10",
    "prettier-plugin-tailwindcss": "0.6.14",
    "rimraf": "6.1.3",
    "tailwindcss": "3.4.19",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.0",
    "vite": "6.4.5",
    "vitest": "4.1.12",
    "vue-eslint-parser": "10.4.1",
    "vue-tsc": "2.2.12"
  },
  "lint-staged": {
    "*.{js,cjs,mjs,ts,cts,mts,tsx,vue,json,yml,yaml}": [
      "prettier --write"
    ],
    "*.{js,cjs,mjs,ts,cts,mts,tsx,vue}": [
      "eslint --fix"
    ],
    "*.md": [
      "prettier --write"
    ]
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  }
}
