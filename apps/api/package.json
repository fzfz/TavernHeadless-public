{
  "name": "@tavern/api",
  "version": "0.2.0-beta.3",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "dev": "tsx watch --conditions=development --include '../../packages/*/src/**' src/index.ts",
    "build": "tsc -p tsconfig.json && node scripts/copy-native-module-worker.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "test": "vitest run --passWithNoTests",
    "db:generate": "drizzle-kit generate --config drizzle.config.ts",
    "db:migrate": "tsx src/db/migrate.ts",
    "bench:history": "tsx scripts/benchmark-history.ts",
    "smoke": "tsx scripts/smoke-api.ts",
    "real-provider:regression": "tsx scripts/real-provider-regression.ts",
    "jobs:chat-transfer": "tsx src/chat-transfer-worker.ts",
    "jobs:backup": "tsx src/backup-worker.ts",
    "memory:maintenance": "tsx scripts/memory-maintenance.ts",
    "db:studio": "drizzle-kit studio --config drizzle.config.ts",
    "openapi:export": "tsx scripts/export-openapi.ts",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@fastify/cors": "11.2.0",
    "@fastify/jwt": "10.2.5",
    "@fastify/sensible": "6.0.7",
    "@fastify/swagger": "9.9.2",
    "@fastify/swagger-ui": "6.1.2",
    "@fastify/websocket": "11.3.4",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@tavern/adapters-sillytavern": "workspace:*",
    "@tavern/core": "workspace:*",
    "@tavern/shared": "workspace:*",
    "ajv": "8.18.0",
    "better-sqlite3": "12.8.0",
    "css-tree": "3.2.1",
    "drizzle-orm": "0.45.2",
    "fastify": "5.12.7",
    "nanoid": "5.1.16",
    "parse5": "8.0.1",
    "typescript": "5.9.3",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "7.6.13",
    "@types/css-tree": "3.2.0",
    "@types/node": "22.20.5",
    "@types/ws": "8.18.2",
    "tsx": "4.23.15",
    "vitest": "4.1.12"
  },
  "files": [
    "dist",
    "config",
    "drizzle"
  ]
}
