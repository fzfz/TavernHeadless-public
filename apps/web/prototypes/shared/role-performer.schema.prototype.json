{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Proposed session performer display identity",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "avatar"],
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1
    },
    "avatar": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9_-]+\\.svg$"
    }
  }
}
