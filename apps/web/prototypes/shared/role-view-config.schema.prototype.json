{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Proposed role presentation config — prototype only",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "layout",
    "title",
    "accent",
    "meterKey",
    "meterLabel",
    "meterMax",
    "showChoices",
    "bodyMarker",
    "html",
    "bindings",
    "css",
    "media",
    "characterName",
    "choices",
    "chatTheme",
    "shell",
    "scene"
  ],
  "properties": {
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "layout": {
      "enum": [
        "stage",
        "inline",
        "novel"
      ]
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "accent": {
      "type": "string",
      "pattern": "^#[0-9a-fA-F]{6}$"
    },
    "meterKey": {
      "enum": [
        "relationship.trust"
      ]
    },
    "meterLabel": {
      "type": "string",
      "minLength": 1
    },
    "meterMax": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "showChoices": {
      "type": "boolean"
    },
    "bodyMarker": {
      "type": "string"
    },
    "html": {
      "type": "string",
      "minLength": 1
    },
    "bindings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "location",
        "time",
        "clue"
      ],
      "properties": {
        "location": {
          "enum": [
            "scene.location",
            "scene.time",
            "story.clue"
          ]
        },
        "time": {
          "enum": [
            "scene.location",
            "scene.time",
            "story.clue"
          ]
        },
        "clue": {
          "enum": [
            "scene.location",
            "scene.time",
            "story.clue"
          ]
        }
      }
    },
    "css": {
      "type": "string"
    },
    "media": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "background",
        "portrait",
        "characterAvatar"
      ],
      "properties": {
        "background": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[a-zA-Z0-9_-]+\\.svg$"
            },
            {
              "type": "null"
            }
          ]
        },
        "portrait": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[a-zA-Z0-9_-]+\\.svg$"
            },
            {
              "type": "null"
            }
          ]
        },
        "characterAvatar": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_-]+\\.svg$"
        }
      }
    },
    "characterName": {
      "type": "string",
      "minLength": 1
    },
    "choices": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "text",
          "action"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "text": {
            "type": "string",
            "minLength": 1
          },
          "action": {
            "enum": [
              "send",
              "fill"
            ]
          }
        }
      }
    },
    "chatTheme": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "surface",
        "text"
      ],
      "properties": {
        "surface": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}([0-9a-fA-F]{2})?$"
        },
        "text": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}([0-9a-fA-F]{2})?$"
        }
      }
    },
    "shell": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "html",
        "css"
      ],
      "properties": {
        "html": {
          "type": "string",
          "minLength": 1
        },
        "css": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "scene": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "html",
        "css"
      ],
      "properties": {
        "html": {
          "type": "string",
          "minLength": 1
        },
        "css": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "novel": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "autoMs",
        "bgm",
        "gallery"
      ],
      "properties": {
        "autoMs": {
          "type": "integer",
          "minimum": 500
        },
        "bgm": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_-]+\\.wav$"
        },
        "gallery": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9_-]+\\.svg$"
          }
        }
      }
    }
  }
}
