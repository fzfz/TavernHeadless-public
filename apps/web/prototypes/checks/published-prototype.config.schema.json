{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "port",
    "dataDirectory",
    "credentialsFile",
    "masterKeyFile",
    "characters",
    "presetDirectory",
    "performers",
    "disabledSlots",
    "defaultUpdaterSlot",
    "modelTimeoutMs",
    "presetPromptOrderCharacterId",
    "narratorContextTokens",
    "llmProfileApiMode"
  ],
  "properties": {
    "port": {
      "type": "integer",
      "minimum": 1,
      "maximum": 65535
    },
    "dataDirectory": {
      "type": "string",
      "minLength": 1
    },
    "credentialsFile": {
      "type": "string",
      "minLength": 1
    },
    "masterKeyFile": {
      "type": "string",
      "minLength": 1
    },
    "characters": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "presetDirectory": {
      "type": "string",
      "minLength": 1
    },
    "performers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "name",
          "description"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "disabledSlots": {
      "type": "array",
      "items": {
        "enum": [
          "director",
          "verifier",
          "memory"
        ]
      }
    },
    "defaultUpdaterSlot": {
      "type": "string",
      "minLength": 1
    },
    "modelTimeoutMs": {
      "type": "integer",
      "minimum": 1
    },
    "presetPromptOrderCharacterId": {
      "type": "integer",
      "minimum": 1
    },
    "narratorContextTokens": {
      "type": "integer",
      "minimum": 1
    },
    "llmProfileApiMode": {
      "enum": [
        "chat",
        "completion",
        "responses"
      ]
    }
  },
  "additionalProperties": false
}
