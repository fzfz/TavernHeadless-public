{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "narratorPrompt": {
      "type": "string",
      "minLength": 1
    },
    "updaterPrompt": {
      "type": "string",
      "minLength": 1
    },
    "writablePaths": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^/"
      }
    },
    "stateSchema": {
      "type": "object"
    },
    "stateSchemaFile": {
      "type": "string",
      "minLength": 1
    },
    "deriveScript": {
      "type": "string",
      "minLength": 1
    },
    "validateScript": {
      "type": "string",
      "minLength": 1
    },
    "ruleFiles": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "derivedPaths": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "sourceAgentBindingIds": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "factsSchema": {
      "type": "object"
    },
    "followupAgents": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "prompt": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": ["id", "prompt"],
        "additionalProperties": false
      }
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "moduleFiles": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "maxTokens": {
      "type": "integer",
      "minimum": 1
    },
    "promptBundleFile": {
      "type": "string",
      "minLength": 1
    },
    "narratorReasoning": {
      "$ref": "#/definitions/reasoning"
    },
    "updaterReasoning": {
      "$ref": "#/definitions/reasoning"
    }
  },
  "required": ["updaterPrompt", "writablePaths"],
  "additionalProperties": false,
  "anyOf": [
    {
      "required": ["stateSchema"]
    },
    {
      "required": ["stateSchemaFile"]
    }
  ],
  "allOf": [
    {
      "anyOf": [
        {
          "required": ["narratorPrompt"]
        },
        {
          "required": ["promptBundleFile"]
        }
      ]
    }
  ],
  "definitions": {
    "reasoning": {
      "type": "object",
      "properties": {
        "effort": {
          "enum": ["none", "minimal", "low", "medium", "high", "xhigh", "max"]
        }
      },
      "required": ["effort"],
      "additionalProperties": false
    }
  }
}
