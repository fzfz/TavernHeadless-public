          "minimum": 0,
          "maximum": 999
        },
        "堕落": {
          "type": "number",
          "minimum": 0,
          "maximum": 999
        },
        "内心想法": {
          "type": "string",
          "minLength": 5,
          "pattern": "^\\*\\*[\\s\\S]+\\*\\*$"
        }
      },
      "required": ["感情", "堕落", "内心想法"],
      "additionalProperties": false
    },
    "行动选项": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
