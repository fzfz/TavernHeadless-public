{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Documentation and skill sources",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contractVersion",
    "checkedAt",
    "localBaseline",
    "publishedRelationship",
    "sources"
  ],
  "properties": {
    "$schema": {
      "const": "sources.schema.json"
    },
    "contractVersion": {
      "const": 1
    },
    "checkedAt": {
      "type": "string",
      "format": "date-time"
    },
    "localBaseline": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "branch",
        "head",
        "workingTreeCapturedBeforeImplementation",
        "dirtyPaths"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "branch": {
          "type": "string",
          "minLength": 1
        },
        "head": {
          "$ref": "#/$defs/commit"
        },
        "workingTreeCapturedBeforeImplementation": {
          "const": true
        },
        "dirtyPaths": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      }
    },
    "publishedRelationship": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "publishedCommit",
        "relation",
        "commitsAhead"
      ],
      "properties": {
        "publishedCommit": {
          "$ref": "#/$defs/commit"
        },
        "relation": {
          "enum": [
            "ancestor",
            "descendant",
            "equal",
            "diverged",
            "unknown"
          ]
        },
        "commitsAhead": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/source"
      }
    }
  },
  "$defs": {
    "commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "localPath",
        "sourceUrl",
        "sourceCommit",
        "sourcePath",
        "checkStatus",
        "note"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "type": {
          "enum": [
            "local-document",
            "local-code",
            "upstream-release-json"
          ]
        },
        "localPath": {
          "type": "string",
          "minLength": 1
        },
        "sourceUrl": {
          "anyOf": [
            {
              "type": "string",
              "format": "uri"
            },
            {
              "type": "null"
            }
          ]
        },
        "sourceCommit": {
          "anyOf": [
            {
              "$ref": "#/$defs/commit"
            },
            {
              "type": "null"
            }
          ]
        },
        "sourcePath": {
          "type": "string",
          "minLength": 1
        },
        "checkStatus": {
          "enum": [
            "verified",
            "verified-with-differences",
            "pending"
          ]
        },
        "note": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
