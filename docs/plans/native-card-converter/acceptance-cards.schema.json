{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "priority",
    "cards"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "priority": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "cards": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "sourceFile",
          "inputFile"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "sourceFile": {
            "type": "string",
            "minLength": 1
          },
          "inputFile": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
