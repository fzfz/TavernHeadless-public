{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:tavern-headless:conversion-report:draft-1",
  "type": "object",
  "properties": {
    "spec": {
      "const": "tavern_headless_conversion_report"
    },
    "version": {
      "const": "draft-1"
    },
    "conversionId": {
      "type": "string",
      "minLength": 1
    },
    "sourceRevision": {
      "type": "integer",
      "minimum": 1
    },
    "decisionRevision": {
      "type": "integer",
      "minimum": 0
    },
    "reportRevision": {
      "type": "integer",
      "minimum": 1
    },
    "ruleSetVersion": {
      "type": "string",
      "minLength": 1
    },
    "targetSpec": {
      "const": "tavern_headless_card"
    },
    "targetVersion": {
      "const": "1.0.0"
    },
    "state": {
      "enum": [
        "needs_resolution",
        "ready_for_confirmation",
        "confirmed",
        "converted"
      ]
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "itemId": {
            "type": "string",
            "minLength": 1
          },
          "sourceId": {
            "type": "string",
            "minLength": 1
          },
          "pointer": {
            "type": "string"
          },
          "sourceRange": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "start": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "end": {
                    "type": "integer",
                    "minimum": 0
                  }
                },
                "required": ["start", "end"],
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ]
          },
          "detectorId": {
            "type": "string",
            "minLength": 1
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "category": {
            "enum": [
              "identity",
              "lore",
              "opening",
              "state",
              "agent",
              "controller",
              "presentation",
              "asset",
              "preset",
              "regex",
              "extension"
            ]
          },
          "support": {
            "enum": [
              "direct",
              "convertible",
              "review",
              "unsupported",
              "missing_dependency"
            ]
          },
          "severity": {
            "enum": ["info", "confirmation", "blocking"]
          },
          "dependencies": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "targets": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "action": {
            "enum": [
              "unresolved",
              "keep",
              "transform",
              "split",
              "exclude",
              "replace_source"
            ]
          },
          "reason": {
            "type": "string"
          },
          "decidedBy": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ]
          },
          "decisionSourceRevision": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 1
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "itemId",
          "sourceId",
          "pointer",
          "sourceRange",
          "detectorId",
          "evidence",
          "category",
          "support",
          "severity",
          "dependencies",
          "targets",
          "action",
          "reason",
          "decidedBy",
          "decisionSourceRevision"
        ],
        "additionalProperties": false
      }
    },
    "coverage": {
      "type": "object",
      "properties": {
        "sourceNodeCount": {
          "type": "integer",
          "minimum": 0
        },
        "resolvedNodeCount": {
          "type": "integer",
          "minimum": 0
        },
        "unresolvedPointers": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "sourceNodeCount",
        "resolvedNodeCount",
        "unresolvedPointers"
      ],
      "additionalProperties": false
    },
    "approval": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "reportRevision": {
              "type": "integer",
              "minimum": 1
            },
            "confirmedBy": {
              "type": "string",
              "minLength": 1
            },
            "confirmedAt": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": ["reportRevision", "confirmedBy", "confirmedAt"],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "differences": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "itemIds": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "description": {
            "type": "string"
          },
          "requiresConfirmation": {
            "type": "boolean"
          }
        },
        "required": ["itemIds", "description", "requiresConfirmation"],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "spec",
    "version",
    "conversionId",
    "sourceRevision",
    "decisionRevision",
    "reportRevision",
    "ruleSetVersion",
    "targetSpec",
    "targetVersion",
    "state",
    "items",
    "coverage",
    "approval",
    "differences"
  ],
  "additionalProperties": false
}
