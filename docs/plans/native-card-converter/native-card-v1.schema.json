{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:tavern-headless:card:1.0.0",
  "title": "TavernHeadless native card 1.0.0 design draft",
  "type": "object",
  "properties": {
    "spec": {
      "const": "tavern_headless_card"
    },
    "specVersion": {
      "const": "1.0.0"
    },
    "identity": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "cardVersion": {
          "type": "string",
          "minLength": 1
        },
        "createdAt": {
          "type": "string",
          "minLength": 1
        },
        "modifiedAt": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": ["id", "cardVersion", "createdAt", "modifiedAt"],
      "additionalProperties": false
    },
    "character": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "promptName": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "personality": {
          "type": "string"
        },
        "scenario": {
          "type": "string"
        },
        "dialogueExamples": {
          "type": "string"
        },
        "creator": {
          "type": "string"
        },
        "creatorNotes": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "sources": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "name",
        "promptName",
        "description",
        "personality",
        "scenario",
        "dialogueExamples",
        "creator",
        "creatorNotes",
        "tags",
        "sources"
      ],
      "additionalProperties": false
    },
    "worldbooks": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/worldbook"
      }
    },
    "openings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/opening"
      }
    },
    "state": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "schemaFile": {
              "type": "string",
              "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?(/|$))[^\\\\:\\u0000]+$",
              "minLength": 1
            },
            "ownership": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/ownership"
              }
            },
            "deriveFiles": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?(/|$))[^\\\\:\\u0000]+$",
                "minLength": 1
              }
            },
            "validateFiles": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?(/|$))[^\\\\:\\u0000]+$",
                "minLength": 1
              }
            }
          },
          "required": [
            "schemaFile",
            "ownership",
            "deriveFiles",
            "validateFiles"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "agents": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/agent"
      }
    },
    "controllers": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/controller"
      }
    },
    "prompting": {
      "type": "object",
      "properties": {
        "presetFile": {
          "type": "string",
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?(/|$))[^\\\\:\\u0000]+$",
          "minLength": 1
        },
        "regexFiles": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?(/|$))[^\\\\:\\u0000]+$",
            "minLength": 1
          }
        },
        "deliverySchemaFile": {
          "type": "string",
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?(/|$))[^\\\\:\\u0000]+$",
          "minLength": 1
        },
        "narrativePerson": {
          "enum": ["first", "second", "third"]
        },
        "macroBindings": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "characterSystemPrompt": {
          "type": "string"
        },
        "postHistoryInstructions": {
          "type": "string"
        },
        "generationParamsFile": {
          "type": "string",
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?(/|$))[^\\\\:\\u0000]+$",
          "minLength": 1
        }
      },
      "required": [
        "presetFile",
        "regexFiles",
        "deliverySchemaFile",
        "narrativePerson",
        "macroBindings",
        "characterSystemPrompt",
        "postHistoryInstructions",
        "generationParamsFile"
      ],
      "additionalProperties": false
    },
    "presentation": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "manifestFile": {
              "type": "string",
              "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?(/|$))[^\\\\:\\u0000]+$",
              "minLength": 1
            },
            "dependencyFiles": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?(/|$))[^\\\\:\\u0000]+$",
                "minLength": 1
              }
            }
          },
          "required": ["manifestFile", "dependencyFiles"],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "files": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/file"
      }
    },
    "requirements": {
      "type": "object",
      "properties": {
        "runtime": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/requirement"
          }
        },
        "modelSlots": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "capabilities": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "required": ["id", "capabilities"],
            "additionalProperties": false
          }
        },
        "persona": {
          "type": "object",
          "properties": {
            "required": {
              "type": "boolean"
            },
            "templateFile": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?(/|$))[^\\\\:\\u0000]+$",
                  "minLength": 1
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": ["required", "templateFile"],
          "additionalProperties": false
        }
      },
      "required": ["runtime", "modelSlots", "persona"],
      "additionalProperties": false
    },
    "provenance": {
      "type": "object",
      "properties": {
        "origin": {
          "enum": ["authored", "converted", "existing-resource-export"]
        },
        "converterVersion": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "ruleSetVersion": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "sources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/source"
          }
        },
        "mappings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/mapping"
          }
        },
        "differences": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/difference"
          }
        }
      },
      "required": [
        "origin",
        "converterVersion",
        "ruleSetVersion",
        "sources",
        "mappings",
        "differences"
      ],
      "additionalProperties": false
    },
    "extensions": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "purpose": {
            "const": "metadata"
          },
          "data": {
            "type": "object",
            "additionalProperties": true
          }
        },
        "required": ["purpose", "data"],
        "additionalProperties": false
      }
    },
    "kind": {
      "const": "complete"
    }
  },
  "required": [
    "spec",
    "specVersion",
    "identity",
    "character",
    "worldbooks",
    "openings",
    "state",
    "agents",
    "controllers",
    "prompting",
    "presentation",
    "files",
    "requirements",
    "provenance",
    "extensions",
    "kind"
  ],
  "additionalProperties": false,
  "$defs": {
    "file": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?(/|$))[^\\\\:\\u0000]+$",
          "minLength": 1
        },
        "purpose": {
          "enum": [
            "schema",
            "prompt",
            "rule",
            "preset",
            "regex",
            "controller",
            "derive",
            "validate",
            "template",
            "browser_script",
            "style",
            "media",
            "data"
          ]
        },
        "mime": {
          "type": "string",
          "minLength": 1
        },
        "encoding": {
          "enum": ["utf8", "base64"]
        },
        "content": {
          "type": "string"
        }
      },
      "required": ["path", "purpose", "mime", "encoding", "content"],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "encoding": {
                "const": "base64"
              }
            }
          },
          "then": {
            "properties": {
              "content": {
                "type": "string",
                "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
              }
            }
          }
        }
      ]
    },
    "requirement": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "required": {
          "type": "boolean"
        },
        "usedBy": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^/"
          }
        }
      },
      "required": ["id", "version", "required", "usedBy"],
      "additionalProperties": false
    },
    "worldbookEntry": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string"
        },
        "content": {
          "type": "string"
        },
        "enabled": {
          "type": "boolean"
        },
        "keys": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "secondaryKeys": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "constant": {
          "type": "boolean"
        },
        "caseSensitive": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ]
        },
        "matchMode": {
          "enum": ["keyword", "regex"]
        },
        "secondaryMode": {
          "enum": ["none", "any", "all", "not_any", "not_all"]
        },
        "insertion": {
          "type": "object",
          "properties": {
            "slot": {
              "enum": [
                "before_character",
                "after_character",
                "before_author_note",
                "after_author_note",
                "before_examples",
                "after_examples",
                "history",
                "outlet"
              ]
            },
            "depth": {
              "type": "integer",
              "minimum": 0
            },
            "role": {
              "enum": ["system", "user", "assistant"]
            },
            "order": {
              "type": "integer"
            },
            "priority": {
              "type": "integer"
            },
            "outlet": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": ["slot", "depth", "role", "order", "priority", "outlet"],
          "additionalProperties": false
        },
        "scanDepth": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "matchWholeWords": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ]
        },
        "excludeRecursion": {
          "type": "boolean"
        },
        "preventRecursion": {
          "type": "boolean"
        },
        "delayUntilRecursion": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "metadata": {
          "type": "object",
          "additionalProperties": true
        }
      },
      "required": [
        "id",
        "name",
        "content",
        "enabled",
        "keys",
        "secondaryKeys",
        "constant",
        "caseSensitive",
        "matchMode",
        "secondaryMode",
        "insertion",
        "scanDepth",
        "matchWholeWords",
        "excludeRecursion",
        "preventRecursion",
        "delayUntilRecursion",
        "metadata"
      ],
      "additionalProperties": false
    },
    "worldbook": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "scanDepth": {
          "type": "integer",
          "minimum": 0
        },
        "tokenBudget": {
          "type": "integer",
          "minimum": 0
        },
        "recursive": {
          "type": "boolean"
        },
        "entries": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/worldbookEntry"
          }
        },
        "caseSensitive": {
          "type": "boolean"
        },
        "matchWholeWords": {
          "type": "boolean"
        },
        "maxRecursionSteps": {
          "type": "integer",
          "minimum": 0
        },
        "metadata": {
          "type": "object",
          "additionalProperties": true
        }
      },
      "required": [
        "id",
        "name",
        "scanDepth",
        "tokenBudget",
        "recursive",
        "entries",
        "caseSensitive",
        "matchWholeWords",
        "maxRecursionSteps",
        "metadata"
      ],
      "additionalProperties": false
    },
    "opening": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": ["story", "introduction"]
        },
        "default": {
          "type": "boolean"
        },
        "text": {
          "type": "string"
        },
        "initialState": {
          "type": "object",
          "additionalProperties": true
        }
      },
      "required": ["id", "title", "kind", "default", "text", "initialState"],
      "additionalProperties": false
    },
    "agent": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": ["state_update", "director", "verifier", "memory"]
        },
        "enabled": {
          "type": "boolean"
        },
        "promptFile": {
          "type": "string",
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?(/|$))[^\\\\:\\u0000]+$",
          "minLength": 1
        },
        "ruleFiles": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?(/|$))[^\\\\:\\u0000]+$",
            "minLength": 1
          }
        },
        "inputSchemaFile": {
          "type": "string",
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?(/|$))[^\\\\:\\u0000]+$",
          "minLength": 1
        },
        "outputSchemaFile": {
          "type": "string",
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?(/|$))[^\\\\:\\u0000]+$",
          "minLength": 1
        },
        "modelSlot": {
          "type": "string",
          "minLength": 1
        },
        "requiredCapabilities": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "generationParamsFile": {
          "type": "string",
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?(/|$))[^\\\\:\\u0000]+$",
          "minLength": 1
        }
      },
      "required": [
        "id",
        "kind",
        "enabled",
        "promptFile",
        "ruleFiles",
        "inputSchemaFile",
        "outputSchemaFile",
        "modelSlot",
        "requiredCapabilities",
        "generationParamsFile"
      ],
      "additionalProperties": false
    },
    "controller": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "moduleFile": {
          "type": "string",
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?(/|$))[^\\\\:\\u0000]+$",
          "minLength": 1
        },
        "dependencyFiles": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?(/|$))[^\\\\:\\u0000]+$",
            "minLength": 1
          }
        },
        "worldbookEntryIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "stage": {
          "enum": ["before_narration", "after_narration"]
        },
        "reads": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "writes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "variableRoot": {
          "type": "string"
        },
        "variableMacros": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "source": {
                "type": "string"
              },
              "target": {
                "type": "string"
              }
            },
            "required": ["source", "target"],
            "additionalProperties": false
          }
        },
        "updaterEntryIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "id",
        "moduleFile",
        "dependencyFiles",
        "worldbookEntryIds",
        "stage",
        "reads",
        "writes",
        "variableRoot",
        "variableMacros",
        "updaterEntryIds"
      ],
      "additionalProperties": false
    },
    "ownership": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "owner": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": ["path", "owner"],
      "additionalProperties": false
    },
    "source": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "format": {
          "type": "string",
          "minLength": 1
        },
        "filename": {
          "type": "string",
          "minLength": 1
        },
        "document": {
          "type": "object",
          "additionalProperties": true
        }
      },
      "required": ["id", "format", "filename", "document"],
      "additionalProperties": false
    },
    "mapping": {
      "type": "object",
      "properties": {
        "sourceId": {
          "type": "string",
          "minLength": 1
        },
        "pointer": {
          "type": "string"
        },
        "ranges": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "start": {
                "type": "integer",
                "minimum": 0
              },
              "end": {
                "type": "integer",
                "minimum": 0
              }
            },
            "required": ["start", "end"],
            "additionalProperties": false
          }
        },
        "action": {
          "enum": ["keep", "transform", "split", "exclude"]
        },
        "targets": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "sourceId",
        "pointer",
        "ranges",
        "action",
        "targets",
        "reason"
      ],
      "additionalProperties": false
    },
    "difference": {
      "type": "object",
      "properties": {
        "sourceId": {
          "type": "string",
          "minLength": 1
        },
        "pointer": {
          "type": "string"
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "confirmedBy": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "sourceId",
        "pointer",
        "description",
        "reason",
        "confirmedBy"
      ],
      "additionalProperties": false
    }
  }
}
