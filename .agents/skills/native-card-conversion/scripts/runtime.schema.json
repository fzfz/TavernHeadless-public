{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "packageVersion",
    "apiVersion",
    "skillDirectory",
    "outputDirectory",
    "entrypoint",
    "packageSchema",
    "fileRules",
    "acceptanceCards",
    "examples",
    "readOnlyDirectories",
    "zipFile",
    "runner",
    "stateOutputDiagnostics"
  ],
  "properties": {
    "resultPartBytes": {
      "type": "integer",
      "minimum": 4
    },
    "creationWaitMs": {
      "type": "integer",
      "minimum": 0
    },
    "$schema": {
      "type": "string",
      "minLength": 1
    },
    "packageVersion": {
      "const": "1.0.0"
    },
    "apiVersion": {
      "const": 1
    },
    "skillDirectory": {
      "type": "string",
      "minLength": 1
    },
    "outputDirectory": {
      "type": "string",
      "minLength": 1
    },
    "entrypoint": {
      "type": "string",
      "minLength": 1
    },
    "packageSchema": {
      "type": "string",
      "minLength": 1
    },
    "fileRules": {
      "type": "string",
      "minLength": 1
    },
    "acceptanceCards": {
      "type": "string",
      "minLength": 1
    },
    "readOnlyDirectories": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "zipFile": {
      "type": "string",
      "minLength": 1
    },
    "runner": {
      "type": "object",
      "additionalProperties": false,
      "required": ["program", "arguments"],
      "properties": {
        "program": {
          "type": "string",
          "minLength": 1
        },
        "arguments": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "stateOutputDiagnostics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pathInvalid", "buildFailed"],
      "properties": {
        "pathInvalid": {
          "$ref": "#/$defs/stateOutputDiagnosticTemplate"
        },
        "buildFailed": {
          "$ref": "#/$defs/stateOutputDiagnosticTemplate"
        }
      }
    },
    "examples": {
      "type": "object",
      "additionalProperties": false,
      "required": ["preview", "replayFixture", "acceptance"],
      "properties": {
        "preview": {
          "type": "string",
          "minLength": 1
        },
        "replayFixture": {
          "type": "string",
          "minLength": 1
        },
        "acceptance": {
          "type": "string",
          "minLength": 1
        }
      },
      "description": "Paths from the worktree root to the preview, offline-replay, and acceptance examples."
    }
  },
  "$defs": {
    "stateOutputDiagnosticTemplate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "messageTemplate", "actionTemplate"],
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1
        },
        "messageTemplate": {
          "type": "string",
          "minLength": 1
        },
        "actionTemplate": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
