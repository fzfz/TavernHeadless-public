{
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "documents"],
  "properties": {
    "$schema": {
      "type": "string",
      "minLength": 1
    },
    "documents": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "file",
          "source",
          "sourceCommit",
          "sourceRevision",
          "apiVersion",
          "packageVersion"
        ],
        "properties": {
          "file": {
            "type": "string",
            "minLength": 1
          },
          "source": {
            "type": "string",
            "minLength": 1
          },
          "sourceCommit": {
            "type": "string",
            "minLength": 1
          },
          "sourceRevision": {
            "const": "working-tree"
          },
          "apiVersion": {
            "const": 1
          },
          "packageVersion": {
            "const": "1.0.0"
          },
          "referenceReplacements": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["from", "to"],
              "properties": {
                "from": {
                  "type": "string",
                  "pattern": "^[^\\s]+\\.(md|json)(#[^\\s]*)?$"
                },
                "to": {
                  "type": "string",
                  "pattern": "^[^\\s]+\\.(md|json)(#[^\\s]*)?$"
                }
              }
            }
          }
        }
      }
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
